.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
# Anchored to the root on purpose. A bare 'data/' matches any directory of
# that name at any depth, which silently swallowed web/data/ - the demo
# tileset the published viewer loads - and would have failed the Pages
# deploy on a fresh checkout.
/data/
out/harness*/
out/
runs/
models/
# jsdom for the headless page checks (scripts/check_site.js, check_app.js).
# Installed with --no-save, so there is no manifest to commit either.
node_modules/
package-lock.json
web/node_modules/
web/dist/
*.egg-info/
.vscode/
.idea/
.DS_Store

# Study outputs. Keep dataset.json and the per-scene quick-look PNGs - those
# are the evidence, and results.html renders them straight out of the repo.
# Drop the GeoTIFFs: they are ~12 MB per scene and rebuild from the recorded
# inputs.
results/**/*.tif
results/**/*.tiff

# Phase 3 and 4 output now lives inside each scene's own directory, which is
# the point - a scene is one folder. It is not committed: the tileset for the
# demo scene is already at web/data/, an OBJ at stride 2 is 34 MB on its own,
# and both rebuild from the committed rasters in seconds with `ayama build` or
# `ayama mesh`. tileset.json IS committed, so what was built stays on record.
results/**/tiles3d/tiles/
results/**/mesh/
results/_delivery_work/

# Quick-look rasters are committed for the primary arm only - the one with the
# fitted structural scale, which is what results.html shows for every arm. The
# others are near-identical to the eye (the finding is in the metrics, not the
# pictures) and five copies would put 40 MB in the repository for nothing. The
# dataset.json of EVERY arm is committed: that is where the findings live.
results/cpu/real_vitl_h1/**/*.png
results/cpu/real_vitl_h1/**/*.jpg
results/cpu/real_vits_learned/**/*.png
results/cpu/real_vits_learned/**/*.jpg
results/cpu/real_vitl_h2/**/*.png
results/cpu/real_vitl_h2/**/*.jpg
results/cpu/real_vits_h1/**/*.png
results/cpu/real_vits_h1/**/*.jpg
results/cpu/real_vits_h2/**/*.png
results/cpu/real_vits_h2/**/*.jpg
