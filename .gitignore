.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
data/
out/harness*/
out/
runs/
models/
# jsdom for the headless page checks (scripts/check_site.js, check_app.js).
# Installed with --no-save, so there is no manifest to commit either.
node_modules/
package-lock.json
web/node_modules/
web/dist/
*.egg-info/
.DS_Store

# Study outputs: keep the JSON, the report and the web previews (they are the
# evidence the site renders); drop the rasters, which are large and regenerate
# byte-identically from the recorded seed.
results/**/*.tif
results/**/*.tiff
# Full-resolution quick-looks from the run stage: the site reads results/*/preview/
# instead, and the Pages workflow never publishes these.
results/**/run/*.png
results/**/run/*.jpg

# The delivery benchmark's reference tileset: 42 MB of PNG/JPG/OBJ that
# rebuilds from results/seed7/run in about 5 s. delivery.json and DELIVERY.md
# are the evidence and are committed; the tiles are not.
results/tileset/
results/_delivery_work/
